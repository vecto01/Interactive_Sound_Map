/* ===== БАЗОВЫЕ СТИЛИ ===== */
body {
  background-color: #ffffff;
  color: #333333;
  font-family: Arial, sans-serif;
}

/* ===== АНИМАЦИИ ЗАГРУЗКИ ===== */
.loading-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid rgba(76, 175, 80, 0.3);
  border-radius: 50%;
  border-top-color: #10B981;
  animation: pulse 1.5s ease-in-out infinite;
}

.loading-text {
  color: #10B981;
  font-weight: bold;
  transition: color 0.3s ease;
}

.success-text {
  color: #10B981;
  font-weight: bold;
  animation: fadeIn 0.5s ease-out forwards;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== ЦЕНТРИРОВАНИЕ И АДАПТИВНОСТЬ ===== */
.container {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
}

/* ===== МЕДИА-КВАРТЫ ===== */
@media (min-width: 768px) { /* Десктоп и планшет */
  .loading {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 20px 0;
  }
  .loading-text {
    font-size: 1.3rem;
  }
}

@media (max-width: 767px) { /* Мобильные устройства */
  .loading {
    display: block;
    text-align: center;
    margin: 15px 0;
    padding: 10px 0;
  }
  .loading-spinner {
    width: 28px;
    height: 28px;
    margin: 0 auto 8px;
  }
  .loading-text {
    font-size: 1.1rem;
  }
}

/* ===== СООБЩЕНИЕ О ЗАВЕРШЕНИИ ===== */
.success-message {
  display: none;
  animation: fadeIn 0.5s ease-out forwards;
  text-align: center;
}
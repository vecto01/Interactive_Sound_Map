<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interactive Sound Map</title>
  <link rel="stylesheet" href="css/styles.css">
  <link rel="stylesheet" href="css/skeleton-loader.css">
</head>
<body>
  <header>
    <div class="logo">Interactive Sound Map</div>
  </header>

  <div class="loading-container">
    <div class="skeleton-loader"></div>
    <div class="loading-text">Loading...</div>
  </div>

  <div class="map-container">
    <!-- Карта и контент будут загружены здесь -->
  </div>

  <footer>
    <p>© 2023 Interactive Sound Map. All rights reserved.</p>
  </footer>

  <script src="js/main.js"></script>
  <script src="js/loading.js"></script>
</body>
</html>